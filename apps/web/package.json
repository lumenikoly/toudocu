{
  "name": "@toudocu/web-app",
  "version": "0.0.0-migration",
  "private": true,
  "type": "module",
  "exports": {
    "./renderer": {
      "types": "./renderer/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "vite --configLoader runner build --mode client && vite --configLoader runner build --ssr renderer/index.tsx --mode renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm --filter toudocu-ts... -r build && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@toudocu/contracts": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "mermaid": "12.0.0",
    "codemirror": "6.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0",
    "swagger-ui-dist": "5.32.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@toudocu/core": "workspace:*",
    "@toudocu/portal": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "29.1.1",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "5.0.1"
  }
}
